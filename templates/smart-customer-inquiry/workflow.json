    {
      "id": "map-form-fields",
      "name": "Map form fields (version compatibility)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        80
      ],
      "parameters": {
        "jsCode": "// Form Trigger 2.2 returns labels; newer versions can return field names.\nconst canonical = (key) => String(key).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');\nconst values = Object.fromEntries(Object.entries($json).map(([key, value]) => [canonical(key), value]));\nconst get = (...keys) => { for (const key of keys) { const value = values[canonical(key)]; if (value !== undefined && value !== null) return value; } return ''; };\nconst consent = Object.entries($json).some(([key, value]) => /consent|acknowledge/i.test(key) && Boolean(value));\nreturn [{json:{full_name:get('full_name','full name','name'),email:get('email','email address'),phone:get('phone','phone number'),company:get('company','company name'),category:get('category','inquiry category'),subject:get('subject'),message:get('message'),preferred_contact_method:get('preferred_contact_method','preferred contact method'),consent}}];"
      }
    },
    {
      "id": "note-rules",
      "name": "2 · Validate, classify and deduplicate",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -300,
        -120
      ],
      "parameters": {
        "width": 720,
        "height": 120,
        "color": 0,
        "content": "## 2 · Normalize, validate and deduplicate\nThe mapping node accepts both older label-based and newer custom field-name form output. The Code node then validates, applies priority rules, and calculates the duplicate fingerprint. Exact duplicates suppress a second alert."
      }
    },
    {
      "id": "normalize",
      "name": "Normalize, validate & classify (CONFIG HERE)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        80
      ],
      "parameters": {
        "jsCode": "// CONFIGURATION: edit plain values here; no credentials belong here.\nconst cfg = { duplicateWindowHours: 24, defaultOwner: 'Unassigned', requireConsent: true, reminderHours: { Critical: 1, High: 4, Normal: 24, Low: 48 } };\nconst asText = (value, max) => typeof value === 'string' ? value.trim().replace(/\\s+/g, ' ').slice(0, max) : '';\nconst raw = $json; const full_name = asText(raw.full_name, 120); const email = asText(raw.email, 254).toLowerCase(); const subject = asText(raw.subject, 200); const message = asText(raw.message, 5000); const consent = raw.consent === true || raw.consent === 'true';\nif (!full_name || !email || !subject || !message) throw new Error('Full name, email, subject, and message are required.');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/u.test(email)) throw new Error('Enter a valid email address.'); if (cfg.requireConsent && !consent) throw new Error('Please acknowledge the privacy notice before submitting.');\nconst allowed = ['General inquiry','Sales / quotation','Technical support','Existing customer','Partnership','Complaint','Other']; const category = allowed.includes(raw.category) ? raw.category : 'Other'; const text = `${subject} ${message}`.toLowerCase();\nconst urgent = /\\b(urgent|outage|security incident|data loss|legal escalation)\\b/u.test(text); let priority = category === 'Partnership' ? 'Low' : 'Normal'; if ((category === 'Complaint' || category === 'Technical support') && urgent) priority = 'High'; if (category === 'Complaint' && /\\b(data loss|legal escalation)\\b/u.test(text)) priority = 'Critical'; if (category === 'Sales / quotation' && /\\b(urgent|asap)\\b/u.test(text)) priority = 'High';\nconst now = new Date(); const submitted_at = now.toISOString(); const inquiry_id = `INQ-${submitted_at.replace(/\\D/g,'').slice(0,14)}-${Math.random().toString(36).slice(2,8).toUpperCase()}`;\nreturn [{json:{inquiry_id,full_name,email,phone:asText(raw.phone,50),company:asText(raw.company,160),category,subject,message,preferred_contact_method:asText(raw.preferred_contact_method,30),consent,priority,status:'New',assigned_owner:cfg.defaultOwner,source:'n8n-form',submitted_at,last_activity_at:submitted_at,follow_up_due_at:new Date(now.getTime()+cfg.reminderHours[priority]*3600000).toISOString(),reminder_count:0,last_reminder_at:null,notification_state:'pending',processing_state:'stored',error_state:'',duplicate_of:'',dedupe_key:`${email}|${subject.toLowerCase()}|${message.toLowerCase()}`,duplicate_window_start:new Date(now.getTime()-cfg.duplicateWindowHours*3600000).toISOString()}}];"
      }
    },
