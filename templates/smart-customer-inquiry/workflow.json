        "subject": "={{ '[Follow-up ' + $json.priority + '] ' + $json.inquiry_id + ' needs attention' }}",
        "emailFormat": "text",
        "text": "={{ 'Inquiry ' + $json.inquiry_id + ' remains ' + $json.status + '.\\nOwner: ' + $json.assigned_owner + '\\nDue: ' + $json.follow_up_due_at + '\\nReminder number: ' + (Number($json.reminder_count || 0) + 1) + '\\n\\nUpdate its status in the Data Tables UI when acted on.' }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
