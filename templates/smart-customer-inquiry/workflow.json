    {
      "id": "note-reminder",
      "name": "3 · Scheduled reminders",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -300,
        400
      ],
      "parameters": {
        "width": 1060,
        "height": 120,
        "color": 0,
        "content": "## 3 · Scheduled reminders\nThis lower path runs every hour only after the workflow is published. **Explain reminder eligibility** outputs every stored row with `reminder_eligible` and a `reminder_skip_reason`. A reminder sends only when status is not Resolved/Closed, processing state is `stored`, due time has passed, and reminder count is below 3. Review that node's output first when no email is sent."
      }
    },
    {
      "id": "schedule",
      "name": "Hourly follow-up check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        610
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "get-open",
      "name": "Read inquiry records",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -70,
        610
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "REPLACE_WITH_DATA_TABLE_ID",
          "mode": "id"
        },
        "returnAll": true
      }
    },
    {
      "id": "explain-eligibility",
      "name": "Explain reminder eligibility",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        610
      ],
      "parameters": {
        "jsCode": "const maxReminders = 3; const now = Date.now();\nreturn $input.all().map(({json: r}) => {\n  const reasons = [];\n  if (['Resolved', 'Closed'].includes(r.status)) reasons.push('status is ' + r.status);\n  if (r.processing_state !== 'stored') reasons.push('processing_state is not stored');\n  if (Number(r.reminder_count || 0) >= maxReminders) reasons.push('maximum reminder count reached');\n  if (!r.follow_up_due_at || Number.isNaN(Date.parse(r.follow_up_due_at))) reasons.push('follow_up_due_at is missing or invalid');\n  else if (Date.parse(r.follow_up_due_at) > now) reasons.push('follow-up is not due yet');\n  return { json: { ...r, reminder_eligible: reasons.length === 0, reminder_skip_reason: reasons.join('; ') || 'eligible now', reminder_checked_at: new Date(now).toISOString() } };\n});"
      }
    },
    {
      "id": "eligible",
      "name": "Send only eligible reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        610
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(({ json }) => json.reminder_eligible === true);"
      }
    },
